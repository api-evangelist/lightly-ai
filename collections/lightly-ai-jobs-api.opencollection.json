{
  "opencollection": "1.0.0",
  "info": {
    "name": "LightlyOne Platform Datasets Jobs API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "token",
      "value": "{{token}}",
      "placement": "query"
    }
  },
  "items": [
    {
      "info": {
        "name": "Jobs",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List recent asynchronous jobs.",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.lightly.ai/v1/jobs"
          },
          "docs": "List recent asynchronous jobs."
        },
        {
          "info": {
            "name": "Get the status of an asynchronous job by id.",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.lightly.ai/v1/jobs/:jobId",
            "params": [
              {
                "name": "jobId",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Get the status of an asynchronous job by id."
        }
      ]
    }
  ],
  "bundled": true
}